
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jci-presence",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-26",

  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "routes": [
    {
      "pattern": "presence.jcicomee.org",
      "custom_domain": true
    }
  ],

  "workers_dev": false,
  "preview_urls": false
}
